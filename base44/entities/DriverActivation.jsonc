{
  "name": "DriverActivation",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string"
    },
    "amount_kzt": {
      "type": "number",
      "enum": [
        500
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "rejected"
      ],
      "default": "pending"
    },
    "requested_at": {
      "type": "string"
    },
    "confirmed_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "payment_reference": {
      "type": "string"
    }
  },
  "required": [
    "driver_id",
    "amount_kzt",
    "status"
  ],
  "rls": {
    "create": {
      "data.driver_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.driver_id": "{{user.id}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}