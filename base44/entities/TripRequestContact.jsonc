{
  "name": "TripRequestContact",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "passenger_id": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "passenger_id",
    "phone"
  ],
  "rls": {
    "create": {
      "data.passenger_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.passenger_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.passenger_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.passenger_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}