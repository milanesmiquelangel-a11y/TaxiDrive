{
  "name": "TripOffer",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "passenger_id": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "price_kzt": {
      "type": "number",
      "minimum": 0
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "withdrawn"
      ],
      "default": "pending"
    }
  },
  "required": [
    "request_id",
    "passenger_id",
    "driver_id",
    "price_kzt",
    "status"
  ],
  "rls": {
    "create": {
      "data.driver_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "data.passenger_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "data.passenger_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}